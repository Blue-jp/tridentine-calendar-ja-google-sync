* text=auto

*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.lock text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# RFC 5545 content lines use CRLF. Fixtures remain synthetic and safe to track.
*.ics text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
