{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Blue-jp/tridentine-calendar-ja-google-sync/blob/main/schemas/production-single-update-plan-v1.schema.json",
  "title": "Non-executable Production Calendar Single Update Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_type", "planning_mode", "production", "production_only",
    "synthetic", "single_update_only", "update_only", "state", "executable",
    "tool_version", "target_fingerprint", "target_safe_ref", "target_config_hash",
    "target_environment", "target_label", "target_purpose", "baseline_hash",
    "baseline_snapshot_hash", "baseline_state", "managed_uid_count", "manifest_hash",
    "source_profile", "accepted_tag", "accepted_commit", "source_sha256",
    "source_content_hash", "source_event_count", "snapshot_hash", "snapshot_event_count",
    "diff_hash", "unchanged_count", "operation_count", "add_count", "update_count",
    "delete_count", "changed_fields", "safe_uid_ref", "google_ref", "pre_image_hash",
    "patch_hash", "eligibility", "approval_required", "plan_content_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_type": { "const": "production_single_update" },
    "planning_mode": { "const": "production_single_update" },
    "production": { "const": true },
    "production_only": { "const": true },
    "synthetic": { "const": false },
    "single_update_only": { "const": true },
    "update_only": { "const": true },
    "state": { "const": "review_required" },
    "executable": { "const": false },
    "tool_version": { "type": "string", "minLength": 1 },
    "target_fingerprint": { "$ref": "#/$defs/sha256" },
    "target_safe_ref": { "$ref": "#/$defs/targetReference" },
    "target_config_hash": { "$ref": "#/$defs/sha256" },
    "target_environment": { "const": "production" },
    "target_label": { "const": "production" },
    "target_purpose": { "const": "production_calendar_single_update" },
    "baseline_hash": { "$ref": "#/$defs/sha256" },
    "baseline_snapshot_hash": { "$ref": "#/$defs/sha256" },
    "baseline_state": { "const": "trusted" },
    "managed_uid_count": { "type": "integer", "minimum": 2 },
    "manifest_hash": { "$ref": "#/$defs/sha256" },
    "source_profile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "accepted_tag": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$" },
    "accepted_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "source_content_hash": { "$ref": "#/$defs/sha256" },
    "source_event_count": { "type": "integer", "minimum": 2 },
    "snapshot_hash": { "$ref": "#/$defs/sha256" },
    "snapshot_event_count": { "type": "integer", "minimum": 2 },
    "diff_hash": { "$ref": "#/$defs/sha256" },
    "unchanged_count": { "type": "integer", "minimum": 1 },
    "operation_count": { "const": 1 },
    "add_count": { "const": 0 },
    "update_count": { "const": 1 },
    "delete_count": { "const": 0 },
    "changed_fields": {
      "type": "array", "prefixItems": [{ "const": "description" }], "items": false,
      "minItems": 1, "maxItems": 1
    },
    "safe_uid_ref": { "$ref": "#/$defs/sourceReference" },
    "google_ref": { "$ref": "#/$defs/googleReference" },
    "pre_image_hash": { "$ref": "#/$defs/sha256" },
    "patch_hash": { "$ref": "#/$defs/sha256" },
    "eligibility": { "const": "eligible" },
    "approval_required": { "const": true },
    "plan_content_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "targetReference": { "type": "string", "pattern": "^T-[0-9a-f]{12}$" },
    "sourceReference": { "type": "string", "pattern": "^U-[0-9a-f]{12}$" },
    "googleReference": { "type": "string", "pattern": "^G-[0-9a-f]{12}$" }
  }
}
