{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blue-jp.example/schemas/production-write-token-readonly-rehearsal-report-v1.schema.json",
  "title": "Production write-token read-only rehearsal report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "foundation_only",
    "live_execution",
    "target_safe_ref",
    "token_role",
    "token_generation",
    "scope_count",
    "scope_exact",
    "token_refresh_count",
    "browser_launch_count",
    "rehearsal_client_construction_count",
    "calendar_api_call_count",
    "list_call_count",
    "get_call_count",
    "read_retry_count",
    "mutation_call_count",
    "target_metadata_verified",
    "snapshot_complete",
    "page_count",
    "event_count",
    "snapshot_content_hash",
    "baseline_cross_binding",
    "source_unchanged_count",
    "source_add_count",
    "source_update_count",
    "source_delete_candidate_count",
    "source_unmanaged_count",
    "source_duplicate_count",
    "source_ambiguous_count",
    "source_invalid_count",
    "source_fatal_count",
    "source_zero_diff",
    "get_performed",
    "get_verified",
    "selected_safe_uid_ref",
    "event_id_present_internally",
    "etag_present_internally",
    "privacy_findings",
    "result_state",
    "safe_code",
    "snapshot_evidence_hash",
    "report_content_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_type": {"const": "production-write-token-readonly-rehearsal-report-v1"},
    "foundation_only": {"const": true},
    "live_execution": {"const": false},
    "target_safe_ref": {"type": "string", "pattern": "^T-[0-9a-f]{12}$"},
    "token_role": {"enum": ["production_write", "production_read", "test_write", "invalid"]},
    "token_generation": {"type": "integer", "minimum": 0},
    "scope_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "scope_exact": {"type": "boolean"},
    "token_refresh_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "browser_launch_count": {"const": 0},
    "rehearsal_client_construction_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "calendar_api_call_count": {"type": "integer", "minimum": 0, "maximum": 5},
    "list_call_count": {"type": "integer", "minimum": 0, "maximum": 5},
    "get_call_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "read_retry_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "mutation_call_count": {"const": 0},
    "target_metadata_verified": {"type": "boolean"},
    "snapshot_complete": {"type": "boolean"},
    "page_count": {"type": "integer", "minimum": 0, "maximum": 5},
    "event_count": {"type": "integer", "minimum": 0},
    "snapshot_content_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "baseline_cross_binding": {"type": "boolean"},
    "source_unchanged_count": {"type": "integer", "minimum": 0},
    "source_add_count": {"type": "integer", "minimum": 0},
    "source_update_count": {"type": "integer", "minimum": 0},
    "source_delete_candidate_count": {"type": "integer", "minimum": 0},
    "source_unmanaged_count": {"type": "integer", "minimum": 0},
    "source_duplicate_count": {"type": "integer", "minimum": 0},
    "source_ambiguous_count": {"type": "integer", "minimum": 0},
    "source_invalid_count": {"type": "integer", "minimum": 0},
    "source_fatal_count": {"type": "integer", "minimum": 0},
    "source_zero_diff": {"type": "boolean"},
    "get_performed": {"type": "boolean"},
    "get_verified": {"type": "boolean"},
    "selected_safe_uid_ref": {"type": ["string", "null"], "pattern": "^U-[0-9a-f]{12}$"},
    "event_id_present_internally": {"type": "boolean"},
    "etag_present_internally": {"type": "boolean"},
    "privacy_findings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "result_state": {
      "enum": [
        "ready",
        "target_mismatch",
        "scope_mismatch",
        "token_role_mismatch",
        "token_refresh_failed",
        "production_full_snapshot_drift",
        "production_source_change_detected",
        "incomplete_snapshot",
        "duplicate_identity",
        "get_verification_failed",
        "api_call_limit_exceeded",
        "privacy_failure",
        "input_binding_mismatch",
        "transport_failed"
      ]
    },
    "safe_code": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,95}$"},
    "snapshot_evidence_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "report_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
