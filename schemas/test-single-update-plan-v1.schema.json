{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Blue-jp/tridentine-calendar-ja-google-sync/blob/main/schemas/test-single-update-plan-v1.schema.json",
  "title": "Private non-executable Test Calendar Single Update Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_type",
    "test_only",
    "single_update_only",
    "production_locked",
    "executable",
    "tool_version",
    "target_fingerprint",
    "target_safe_ref",
    "target_environment",
    "target_label",
    "target_purpose",
    "baseline_hash",
    "baseline_snapshot_hash",
    "baseline_state",
    "managed_uid_count",
    "source_profile",
    "source_sha256",
    "source_event_count",
    "snapshot_hash",
    "snapshot_event_count",
    "diff_hash",
    "operation_count",
    "add_count",
    "update_count",
    "delete_count",
    "changed_fields",
    "safe_uid_ref",
    "original_guard_codes",
    "eligibility",
    "approval_required",
    "plan_content_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_type": { "const": "test_single_update" },
    "test_only": { "const": true },
    "single_update_only": { "const": true },
    "production_locked": { "const": true },
    "executable": { "const": false },
    "tool_version": { "type": "string", "minLength": 1 },
    "target_fingerprint": { "$ref": "#/$defs/sha256" },
    "target_safe_ref": {
      "type": "string",
      "pattern": "^T-[0-9a-f]{12}$",
      "not": { "const": "T-e10f0095ab8f" }
    },
    "target_environment": { "const": "test" },
    "target_label": { "const": "test" },
    "target_purpose": { "const": "test_calendar_write_acceptance" },
    "baseline_hash": { "$ref": "#/$defs/sha256" },
    "baseline_snapshot_hash": { "$ref": "#/$defs/sha256" },
    "baseline_state": { "const": "trusted" },
    "managed_uid_count": { "const": 1 },
    "source_profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "not": { "const": "accepted-20260814" }
    },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "source_event_count": { "const": 1 },
    "snapshot_hash": { "$ref": "#/$defs/sha256" },
    "snapshot_event_count": { "const": 1 },
    "diff_hash": { "$ref": "#/$defs/sha256" },
    "operation_count": { "const": 1 },
    "add_count": { "const": 0 },
    "update_count": { "const": 1 },
    "delete_count": { "const": 0 },
    "changed_fields": { "const": ["description"] },
    "safe_uid_ref": { "type": "string", "pattern": "^U-[0-9a-f]{12}$" },
    "original_guard_codes": {
      "const": ["all_events_update", "mass_change_guard"]
    },
    "eligibility": { "const": "eligible" },
    "approval_required": { "const": true },
    "plan_content_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
