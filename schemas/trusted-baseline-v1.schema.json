{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Blue-jp/tridentine-calendar-ja-google-sync/blob/main/schemas/trusted-baseline-v1.schema.json",
  "title": "Trusted UID baseline",
  "description": "A private candidate or explicitly trusted managed UID inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "tool_version",
    "target_fingerprint",
    "source_profile",
    "accepted_tag",
    "accepted_commit",
    "source_sha256",
    "source_event_count",
    "snapshot_content_hash",
    "snapshot_event_count",
    "diff_content_hash",
    "managed_uid_count",
    "managed_uids",
    "baseline_content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "state": {
      "enum": ["candidate", "trusted"]
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "target_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "source_profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "accepted_tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "accepted_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_event_count": {
      "$ref": "#/$defs/count"
    },
    "snapshot_content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "snapshot_event_count": {
      "$ref": "#/$defs/count"
    },
    "diff_content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "managed_uid_count": {
      "$ref": "#/$defs/count"
    },
    "managed_uids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "baseline_content_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
