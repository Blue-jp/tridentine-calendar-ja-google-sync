{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Blue-jp/tridentine-calendar-ja-google-sync/blob/main/schemas/production-kill-switch-v1.schema.json",
  "title": "Production Single Update Kill Switch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "switch_type", "state", "generation",
    "transition_kind", "previous_switch_hash", "target_safe_ref",
    "issued_at", "content_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "switch_type": { "const": "production-single-update-kill-switch-v1" },
    "state": { "enum": ["off", "on"] },
    "generation": { "type": "integer", "minimum": 0 },
    "transition_kind": { "enum": ["initial", "transition"] },
    "previous_switch_hash": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "target_safe_ref": { "$ref": "#/$defs/targetReference" },
    "issued_at": { "type": "string", "format": "date-time" },
    "content_hash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "transition_kind": { "const": "initial" } },
        "required": ["transition_kind"]
      },
      "then": {
        "properties": {
          "state": { "const": "off" },
          "generation": { "const": 0 },
          "previous_switch_hash": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "transition_kind": { "const": "transition" } },
        "required": ["transition_kind"]
      },
      "then": {
        "properties": {
          "generation": { "minimum": 1 },
          "previous_switch_hash": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "targetReference": { "type": "string", "pattern": "^T-[0-9a-f]{12}$" }
  }
}
