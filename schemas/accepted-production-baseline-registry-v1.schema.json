{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Blue-jp/tridentine-calendar-ja-google-sync/blob/main/schemas/accepted-production-baseline-registry-v1.schema.json",
  "title": "Accepted Production baseline registry",
  "description": "A public-safe packaged registry of full-hash pins for private Trusted Baselines.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_type",
    "production",
    "synthetic",
    "source_repository",
    "sync_repository",
    "active_pin_id",
    "pins",
    "registry_content_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry_type": {"const": "accepted_production_baseline_registry"},
    "production": {"const": true},
    "synthetic": {"const": false},
    "source_repository": {"const": "Blue-jp/tridentine_calendar"},
    "sync_repository": {"const": "Blue-jp/tridentine-calendar-ja-google-sync"},
    "active_pin_id": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/pin_id"}
      ]
    },
    "pins": {
      "type": "array",
      "items": {"$ref": "#/$defs/pin"},
      "uniqueItems": true
    },
    "registry_content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pin_id": {
      "type": "string",
      "pattern": "^production-baseline-g[0-9]{4,}$"
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pin_id",
        "generation",
        "previous_pin_content_hash",
        "baseline_schema_version",
        "tool_version",
        "target_safe_ref",
        "target_config_hash",
        "source_profile",
        "accepted_tag",
        "accepted_commit",
        "source_sha256",
        "source_event_count",
        "snapshot_content_hash",
        "snapshot_event_count",
        "diff_content_hash",
        "managed_uid_count",
        "candidate_content_hash",
        "trusted_baseline_content_hash",
        "pin_content_hash"
      ],
      "properties": {
        "pin_id": {"$ref": "#/$defs/pin_id"},
        "generation": {"type": "integer", "minimum": 1},
        "previous_pin_content_hash": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "baseline_schema_version": {"const": "1.0"},
        "tool_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "target_safe_ref": {"type": "string", "pattern": "^T-[0-9a-f]{12}$"},
        "target_config_hash": {"$ref": "#/$defs/sha256"},
        "source_profile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "accepted_tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        "accepted_commit": {"$ref": "#/$defs/sha1"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_event_count": {"type": "integer", "minimum": 2},
        "snapshot_content_hash": {"$ref": "#/$defs/sha256"},
        "snapshot_event_count": {"type": "integer", "minimum": 2},
        "diff_content_hash": {"$ref": "#/$defs/sha256"},
        "managed_uid_count": {"type": "integer", "minimum": 2},
        "candidate_content_hash": {"$ref": "#/$defs/sha256"},
        "trusted_baseline_content_hash": {"$ref": "#/$defs/sha256"},
        "pin_content_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
