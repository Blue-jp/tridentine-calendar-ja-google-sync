{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Blue-jp/tridentine-calendar-ja-google-sync/blob/main/schemas/production-write-authorized-user-token-v2.schema.json",
  "title": "Private Production Write Authorized User Token with Grant Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "token_type", "role", "target_safe_ref",
    "target_config_hash", "generation", "access_token", "refresh_token",
    "client_id", "client_secret", "token_uri", "scopes", "grant_evidence",
    "expiry"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "token_type": { "const": "production-write-authorized-user-token-v2" },
    "role": { "const": "production_write" },
    "target_safe_ref": { "$ref": "#/$defs/targetReference" },
    "target_config_hash": { "$ref": "#/$defs/sha256" },
    "generation": { "type": "integer", "minimum": 1 },
    "access_token": { "type": "string", "minLength": 1 },
    "refresh_token": { "type": "string", "minLength": 1 },
    "client_id": { "type": "string", "minLength": 1 },
    "client_secret": { "type": "string", "minLength": 1 },
    "token_uri": { "const": "https://oauth2.googleapis.com/token" },
    "scopes": { "$ref": "#/$defs/exactScopes" },
    "grant_evidence": { "$ref": "#/$defs/grantEvidence" },
    "expiry": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "targetReference": { "type": "string", "pattern": "^T-[0-9a-f]{12}$" },
    "exactScopes": {
      "type": "array",
      "prefixItems": [
        { "const": "https://www.googleapis.com/auth/calendar.events.owned" }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "grantEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "evidence_type", "origin",
        "response_scope_field_present", "raw_scope_tokens",
        "granted_scopes", "observed_at"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "evidence_type": { "const": "production-write-granted-scope-evidence-v1" },
        "origin": {
          "enum": [
            "fresh_authorization_response",
            "fresh_refresh_response",
            "test_fixture_authorization_response",
            "test_fixture_refresh_response"
          ]
        },
        "response_scope_field_present": { "const": true },
        "raw_scope_tokens": { "$ref": "#/$defs/exactScopes" },
        "granted_scopes": { "$ref": "#/$defs/exactScopes" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
