{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Blue-jp/tridentine-calendar-ja-google-sync/blob/main/schemas/test-write-report-v2.schema.json",
  "title": "Test Calendar report for an acknowledged import without an event ID",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "live_test_write",
    "test_only",
    "production_locked",
    "target_safe_ref",
    "run_spec_ref",
    "source_ref",
    "operation",
    "state",
    "success",
    "read_back_verified",
    "recovered_after_uncertain",
    "api_call_count",
    "read_retry_count",
    "mutation_attempt_count",
    "mutation_retry_count",
    "stopped",
    "safe_findings",
    "journal_hash",
    "result_hash",
    "report_content_hash"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "report_type": { "const": "test-calendar-write-report-v2" },
    "live_test_write": { "const": true },
    "test_only": { "const": true },
    "production_locked": { "const": true },
    "target_safe_ref": { "type": "string", "pattern": "^T-[0-9a-f]{12}$" },
    "run_spec_ref": { "type": "string", "pattern": "^R-[0-9a-f]{12}$" },
    "source_ref": { "type": "string", "pattern": "^U-[0-9a-f]{12}$" },
    "operation": { "const": "add" },
    "state": { "const": "failed" },
    "success": { "const": false },
    "read_back_verified": { "const": false },
    "recovered_after_uncertain": { "const": false },
    "api_call_count": { "type": "integer", "minimum": 2, "maximum": 9 },
    "read_retry_count": { "type": "integer", "minimum": 0, "maximum": 7 },
    "mutation_attempt_count": { "const": 1 },
    "mutation_retry_count": { "const": 0 },
    "stopped": { "const": true },
    "safe_findings": { "const": ["test_write_read_back_identity_missing"] },
    "journal_hash": { "$ref": "#/$defs/sha256" },
    "result_hash": { "$ref": "#/$defs/sha256" },
    "report_content_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
