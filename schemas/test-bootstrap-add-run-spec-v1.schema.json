{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Blue-jp/tridentine-calendar-ja-google-sync/blob/main/schemas/test-bootstrap-add-run-spec-v1.schema.json",
  "title": "Private Test bootstrap Add Run Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_type",
    "planning_mode",
    "bootstrap_add",
    "test_only",
    "production_locked",
    "tool_version",
    "target_fingerprint",
    "target_safe_ref",
    "target_environment",
    "source_profile",
    "source_sha256",
    "source_event_count",
    "current_snapshot_hash",
    "snapshot_event_count",
    "bootstrap_plan_hash",
    "trusted_baseline_hash",
    "operation_count",
    "add_count",
    "update_count",
    "delete_count",
    "operation",
    "approval_required",
    "run_spec_content_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_type": { "const": "test-bootstrap-add-run-spec-v1" },
    "planning_mode": { "const": "test_bootstrap_add" },
    "bootstrap_add": { "const": true },
    "test_only": { "const": true },
    "production_locked": { "const": true },
    "tool_version": { "type": "string", "minLength": 1 },
    "target_fingerprint": { "$ref": "#/$defs/sha256" },
    "target_safe_ref": {
      "type": "string",
      "pattern": "^T-[0-9a-f]{12}$",
      "not": { "const": "T-e10f0095ab8f" }
    },
    "target_environment": { "const": "test" },
    "source_profile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "source_event_count": { "const": 1 },
    "current_snapshot_hash": { "$ref": "#/$defs/sha256" },
    "snapshot_event_count": { "const": 0 },
    "bootstrap_plan_hash": { "$ref": "#/$defs/sha256" },
    "trusted_baseline_hash": { "type": "null" },
    "operation_count": { "const": 1 },
    "add_count": { "const": 1 },
    "update_count": { "const": 0 },
    "delete_count": { "const": 0 },
    "operation": { "$ref": "#/$defs/addOperation" },
    "approval_required": { "const": true },
    "run_spec_content_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "addOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "source_ref",
        "changed_fields",
        "desired_state",
        "operation_content_hash"
      ],
      "properties": {
        "operation": { "const": "add" },
        "source_ref": { "type": "string", "pattern": "^U-[0-9a-f]{12}$" },
        "changed_fields": {
          "const": ["summary", "description", "start_date", "end_date"]
        },
        "desired_state": { "$ref": "#/$defs/managedState" },
        "operation_content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "managedState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iCalUID",
        "summary",
        "description",
        "start_date",
        "end_date",
        "all_day",
        "event_type"
      ],
      "properties": {
        "iCalUID": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "all_day": { "const": true },
        "event_type": { "const": "default" }
      }
    }
  }
}
